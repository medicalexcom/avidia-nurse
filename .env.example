# Avidia Nurse — environment variables (placeholders only; never commit .env)
#
# Copy this file to `.env` for local development.
#
# RULES (Playbook §5):
#  - Only intentionally PUBLIC, NON-SECRET values may use the EXPO_PUBLIC_
#    prefix. Anything with that prefix is embedded in the client bundle and
#    visible to every user.
#  - Server-only secrets (DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY, AI provider
#    keys, STRIPE keys, SENTRY_DSN, etc.) are introduced with the backend in
#    later milestones, live only in server-side secret storage, and must NEVER
#    be added to client configuration.

# --- public / mobile-safe ---------------------------------------------------

# Which environment the app is running in: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Base URL of the Avidia backend API (optional until the backend exists).
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Public URL of the deployed web app (optional in M0).
# EXPO_PUBLIC_WEB_APP_URL=https://medicalexcom.github.io/avidia-nurse

# Public analytics write key (optional until analytics is enabled).
# EXPO_PUBLIC_ANALYTICS_KEY=

# --- Supabase (M1 auth) -----------------------------------------------------
# Both values are PUBLIC BY DESIGN: the URL identifies the project and the
# anon (publishable) key grants only what row-level security allows.
# Find them in Supabase Dashboard -> Project Settings -> API.
# Without them the app still runs, with sign-in shown as unavailable.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Worker / server only --------------------------------------------------
# Required by the independently deployed document worker. These are server
# configuration/secrets and must be GitHub Actions Secrets (or worker-host
# secrets), never EXPO_PUBLIC_* values.
# SUPABASE_URL=https://your-project-ref.supabase.co

# The SUPABASE_SERVICE_ROLE_KEY is a SECRET. It is used only by server-side
# tooling (e.g. `pnpm run test:authz`), must never use the EXPO_PUBLIC_ prefix,
# and must never be committed or referenced in client code.
# SUPABASE_SERVICE_ROLE_KEY=

# Embedding provider for the background worker (M5). Server-side only —
# provider keys never use the EXPO_PUBLIC_ prefix and never reach the client.
# EMBEDDING_PROVIDER defaults to "openai" (requires OPENAI_API_KEY);
# "hashing" is a deterministic keyless mode for local development ONLY.
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=

# Central AI router configuration (server-only). All are optional overrides;
# defaults are maintained in packages/ai-router/src/openai.ts. Prefer these
# tier settings over the legacy per-gateway model variables below.
# AI_PROVIDER=openai
# AI_MODEL_ECONOMY=gpt-5-mini
# AI_MODEL_STANDARD=gpt-5.1
# AI_MODEL_ADVANCED=gpt-5.2
# AI_MODEL_EMBEDDING=text-embedding-3-small

# Concept-extraction provider for the background worker (M6). Server-side
# only — never EXPO_PUBLIC_, never in the client bundle.
# CONCEPT_PROVIDER defaults to "openai" (requires OPENAI_API_KEY; model
# the router ECONOMY tier by default); "scripted" is a deterministic keyless mode for
# local development and tests ONLY.
# CONCEPT_PROVIDER=openai
# CONCEPT_MODEL= # legacy override; prefer AI_MODEL_ECONOMY

# Question-generation provider for the background worker (M7). Server-side
# only — never EXPO_PUBLIC_, never in the client bundle. Studying never
# requires a live LLM (spec AE): generation is a background pipeline and
# scoring is deterministic in the database.
# QUESTION_PROVIDER defaults to "openai" (requires OPENAI_API_KEY; model
# the router ECONOMY tier by default); "scripted" is a deterministic keyless mode for
# local development and tests ONLY.
# QUESTION_PROVIDER=openai
# QUESTION_MODEL= # legacy override; prefer AI_MODEL_ECONOMY

# --- Billing (M14, server-side ONLY — spec T/U/V) ---------------------------
# ALL billing variables are secrets or server configuration. They are set as
# Supabase Edge Function secrets (`supabase secrets set KEY=value`), NEVER in
# this file's real `.env`, NEVER with the EXPO_PUBLIC_ prefix, NEVER in the
# client bundle. Listed here for documentation only (spec V):
#
# STRIPE_SECRET_KEY      Stripe API secret key (test key in dev/staging, live
#                        key ONLY in the production project's secrets).
# STRIPE_WEBHOOK_SECRET  Signing secret for the stripe-webhook endpoint
#                        (unique per environment/endpoint).
# STRIPE_PRICE_ID_PRO    The recurring Price ID for the PRO subscription in
#                        the matching Stripe mode (test vs live).
# BILLING_RETURN_URL     Where Stripe checkout/portal returns the student
#                        (the deployed app's profile/billing URL).
#
# The client needs NO new variables for billing: checkout and the billing
# portal are reached through authenticated edge-function calls, and
# entitlements come from the get_my_entitlements() RPC.

# Error monitoring (M14 spec AF): if/when crash reporting is enabled, the DSN
# is configured server-side / at build time — never hardcoded in source.
# SENTRY_DSN=
