# Avidia Nurse — client environment variables
#
# Copy this file to `.env` for local development. Never commit `.env`.
#
# RULES:
#  - Only NON-SECRET values may use the EXPO_PUBLIC_ prefix. Anything with
#    that prefix is embedded in the client bundle and visible to every user.
#  - Server/API secrets (AI provider keys, database service keys, etc.) will
#    live exclusively in backend environment configuration (introduced in
#    later milestones) and must NEVER be added to this file.

# Which environment the app is running in: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Base URL of the Avidia backend API (optional until the backend exists).
# EXPO_PUBLIC_API_URL=http://localhost:3000
